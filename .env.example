# OmniPost Environment Variables
# Copy this file to .env and fill in your values.
# All variables are OPTIONAL — the tool runs in stub/dry-run mode without them.

# ── Translation ──────────────────────────────────────────────────────────────
# Anthropic API key for real AI-powered, tone-preserving translation.
# Without this, posts are tagged with [lang] and marked as stubs.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Platform Connectors (all optional — skipped with "no token" message) ─────

# X (Twitter) — requires OAuth 2.0 bearer token
# App dashboard: https://developer.twitter.com/en/portal/dashboard
# X_BEARER_TOKEN=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Weibo — requires OAuth 2.0 access token from Weibo Open Platform
# App dashboard: https://open.weibo.com/
# WEIBO_ACCESS_TOKEN=
# WEIBO_APP_KEY=

# LinkedIn — requires OAuth 2.0 access token + person URN
# App dashboard: https://developer.linkedin.com/
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# Instagram — requires Graph API token + Business account user ID
# App dashboard: https://developers.facebook.com/
# Note: Instagram Graph API requires image/video; text-only posts are not supported.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Threads — Meta's Threads API
# App dashboard: https://developers.facebook.com/ (Threads API)
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=

# Mastodon — open-protocol ActivityPub social network
# Set MASTODON_INSTANCE_URL to your instance (default: https://mastodon.social)
# MASTODON_ACCESS_TOKEN=
# MASTODON_INSTANCE_URL=https://mastodon.social

# Xiaohongshu / 小红书 (Little Red Book)
# Dashboard: https://developers.xiaohongshu.com/
# Note: XHS typically requires images with posts.
# XHS_ACCESS_TOKEN=
# XHS_USER_ID=

# YouTube Community Posts (requires YouTube Data API v3 OAuth token, not just API key)
# Dashboard: https://console.cloud.google.com/
# YOUTUBE_OAUTH_TOKEN=
# YOUTUBE_CHANNEL_ID=
